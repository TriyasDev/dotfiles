{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  // "include": [
  //     ~/.dotfiles/home/modules/configuration/waybar/*
  // ],

  "modules-left": [
      "clock",
      "network",
      "bluetooth",
      "hyprland/window"
  ],

  "modules-center": [
    "custom/rofi",
    "hyprland/workspaces"
  ],

  "modules-right": [
    "group/hardware",
    "group/audio",
    "tray"
  ],

  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "temperature",
      "battery",
      "power-profiles-daemon",
      "backlight"
    ]
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  }
}